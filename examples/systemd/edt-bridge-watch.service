# Edge Bridge: watch the inbox, update the database, deliver events.
# Install as /etc/systemd/system/edt-bridge-watch.service (needs systemd 245 or newer).
[Unit]
Description=Edge Bridge: watch the inbox and deliver events
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=edt
Group=edt
# Lets the bridge read the files the upload account writes.
SupplementaryGroups=edge-upload
Environment=EDT_BRIDGE_CONFIG=/srv/edt/config/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Secrets named in the config as token_env, one NAME=value per line.
# Make the file root:root, mode 0600. The "-" means the service still starts without it.
EnvironmentFile=-/etc/edt-bridge/env
ExecStart=/usr/bin/python3 /opt/edt-bridge/edt_bridge.py watch
Restart=on-failure
RestartSec=10

# Hardening. Each line limits what a bug or a stolen process could do.
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The only places this service may write: the database and the inbox.
ReadWritePaths=/srv/edt/data /srv/edt/sftp/inbox

[Install]
WantedBy=multi-user.target
